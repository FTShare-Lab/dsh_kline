# DeepSeek model calls require this; MCP discovery and local smoke tests do not.
DEEPSEEK_API_KEY=

# Optional overrides. Defaults match the local macOS ft-kline-view setup.
FT_KLINE_VIEW_ROOT=
FT_KLINE_VIEW_PYTHON=

# Keep telemetry disabled during local development unless explicitly enabled.
DSH_TELEMETRY_MODE=DISABLED
