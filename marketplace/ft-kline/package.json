{
  "name": "@ftshare-lab/dsh-kline",
  "version": "0.6.9",
  "description": "DeepSeek Harness K-line plugin for conversational and manual chart drawing, TA-Lib indicators, and FTShare market data.",
  "license": "MIT",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "PROVENANCE.md",
    "README.en.md",
    "README.md",
    "chart_service.py",
    "config",
    "cordis.patch.yml",
    "core",
    "docs/images",
    "docs/release-acceptance-v0.4.0.md",
    "docs/release-acceptance-v0.4.1.md",
    "docs/release-acceptance-v0.5.0.md",
    "docs/release-notes-v0.5.0.md",
    "docs/release-acceptance-v0.6.0.md",
    "docs/release-notes-v0.6.0.md",
    "docs/chart-functions.md",
    "docs/price-pattern-rules-v1.md",
    "docs/price-pattern-samples-v1.md",
    "docs/automatic-drawing.md",
    "docs/fixtures/price-pattern-real-v1.json",
    "!core/**/__pycache__/**",
    "!core/**/*.py[cod]",
    "lib",
    "requirements.txt",
    "screenshots.json",
    "scripts/bootstrap.sh",
    "scripts/run-dsh-kline.mjs",
    "scripts/run-dsh-kline.sh",
    "server.py",
    "tools",
    "!tools/**/__pycache__/**",
    "!tools/**/*.py[cod]",
    "view",
    "docs/release-notes-v0.6.1.md",
    "docs/release-acceptance-v0.6.1.md",
    "docs/release-notes-v0.6.2.md",
    "docs/release-acceptance-v0.6.2.md",
    "docs/release-notes-v0.6.3.md",
    "docs/release-acceptance-v0.6.3.md",
    "scripts/dsh-mcp-plugin.mjs",
    "docs/release-notes-v0.6.4.md",
    "docs/release-acceptance-v0.6.4.md",
    "docs/embedding.md",
    "docs/anonymous-market-support.md",
    "docs/release-notes-v0.6.5.md",
    "docs/release-acceptance-v0.6.5.md",
    "docs/release-notes-v0.6.6.md",
    "docs/release-acceptance-v0.6.6.md",
    "docs/free-foreign-daily.md",
    "docs/release-notes-v0.6.7.md",
    "docs/release-acceptance-v0.6.7.md",
    "docs/release-notes-v0.6.8.md",
    "docs/release-acceptance-v0.6.8.md",
    "scripts/dsh-bootstrap.mjs",
    "docs/release-notes-v0.6.9.md",
    "docs/release-acceptance-v0.6.9.md",
    "docs/npm-release.md",
    "docs/guide.md",
    "docs/guide.en.md",
    "docs/drawing-examples.md",
    "docs/drawing-examples.en.md",
    "docs/provider-adaptation.md"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FTShare-Lab/dsh_kline.git"
  },
  "bugs": {
    "url": "https://github.com/FTShare-Lab/dsh_kline/issues"
  },
  "homepage": "https://github.com/FTShare-Lab/dsh_kline#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "mcp",
    "kline",
    "ftshare"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bootstrap": "node ./scripts/run-dsh-kline.mjs --prepare-project",
    "pack:release": "node ./scripts/build-release-package.mjs ./release/dsh-kline-v0.6.9.tgz",
    "pack:codex": "node ./scripts/build-codex-package.mjs ./release/ft-kline-v0.6.9.zip && node ./scripts/verify-codex-package.mjs ./release/ft-kline-v0.6.9.zip",
    "smoke:codex-package": "python ./scripts/smoke-codex-package.py ./release/ft-kline-v0.6.9.zip",
    "generate:client-view": "node ./scripts/generate-client-view.mjs",
    "build:sidebar": "pnpm generate:client-view && tsc -p tsconfig.json && tsdown --config tsdown.config.ts && pnpm verify:package",
    "verify:package": "node ./scripts/verify-package.mjs",
    "verify:packages": "pnpm verify:package && pnpm pack:release && pnpm pack:codex",
    "dsh:web": "bash ./scripts/run-dsh-web.sh",
    "test": "node ./scripts/run-tests.mjs",
    "test:node": "node ./scripts/run-tests.mjs --node",
    "test:python": "node ./scripts/run-tests.mjs --python",
    "test:launcher": "node --test tests/launcher-paths.test.mjs",
    "generate:codex-catalog": "python scripts/generate-codex-catalog.py",
    "verify:codex-catalog": "python scripts/generate-codex-catalog.py --check",
    "sync:codex-marketplace": "node scripts/sync-codex-marketplace.mjs",
    "verify:codex-marketplace": "node scripts/sync-codex-marketplace.mjs --check",
    "generate:dsh-catalog": "python scripts/generate-dsh-catalog.py",
    "verify:dsh-catalog": "python scripts/generate-dsh-catalog.py --check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "dsh-better-sidebar": "0.19.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "unrun": "^0.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
