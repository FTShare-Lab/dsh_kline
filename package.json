{
  "name": "@ftshare-lab/dsh-kline",
  "version": "0.2.8",
  "private": true,
  "description": "Standalone DeepSeek Harness K-line MCP powered by FTShare.",
  "license": "MIT",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "PROVENANCE.md",
    "README.en.md",
    "README.md",
    "chart_service.py",
    "config",
    "cordis.patch.yml",
    "core",
    "docs/images",
    "!core/**/__pycache__/**",
    "!core/**/*.py[cod]",
    "lib",
    "requirements.txt",
    "screenshots.json",
    "scripts/bootstrap.sh",
    "scripts/run-dsh-kline.mjs",
    "scripts/run-dsh-kline.sh",
    "server.py",
    "tools",
    "!tools/**/__pycache__/**",
    "!tools/**/*.py[cod]",
    "view"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FTShare-Lab/dsh_kline.git"
  },
  "bugs": {
    "url": "https://github.com/FTShare-Lab/dsh_kline/issues"
  },
  "homepage": "https://github.com/FTShare-Lab/dsh_kline#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "mcp",
    "kline",
    "ftshare"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bootstrap": "node ./scripts/run-dsh-kline.mjs --prepare-project",
    "pack:release": "node ./scripts/build-release-package.mjs ./release/dsh-kline.tgz",
    "generate:client-view": "node ./scripts/generate-client-view.mjs",
    "build:sidebar": "pnpm generate:client-view && tsc -p tsconfig.json && tsdown --config tsdown.config.ts && pnpm verify:package",
    "verify:package": "node ./scripts/verify-package.mjs",
    "dsh:web": "bash ./scripts/run-dsh-web.sh",
    "test:launcher": "node --test tests/launcher-paths.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "dsh-better-sidebar": "0.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "unrun": "^0.3.1"
  }
}
